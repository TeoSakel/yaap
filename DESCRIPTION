Package: yaap
Title: Yet Another Archetypes Package for Multivariate and Functional Data
Version: 1.0.0
Authors@R: c(
    person("Teo", "Sakel",
           email = "teo@intelligentbiodata.com",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0001-9946-9498")),
    person("MCIU/AEI",
